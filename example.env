NEXT_PUBLIC_PROJECT_NAME="Nome do Projeto ATIC Ano"
AUTH_SECRET=CHAVE

AUTH_URL=http://localhost:3001

# --- Banco de dados ---
DATABASE_URL="mysql://user:pass@localhost:3306/antares"

# --- JWT legado (mantido durante toda a migração) ---
JWT_SECRET=
RT_SECRET=

# --- LDAP/AD ---
# Ambiente: local (pula bind LDAP no login) ou production (usa LDAP)
ENVIRONMENT=local

LDAP_SERVER=
LDAP_DOMAIN=
LDAP_BASE=

# Credenciais do usuário de serviço LDAP (bind administrativo para busca de usuários)
USER_LDAP=
PASS_LDAP=
